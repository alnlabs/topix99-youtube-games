{
  "name": "topix99-youtube-games",
  "version": "1.0.0",
  "description": "Topix99 YouTube Live Broadcast & Game Engine",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "default": "cross-env MODE=default node server.js",
    "dev": "cross-env MODE=default nodemon server.js",
    "game:luckywheel": "cross-env MODE=luckywheel node server.js",
    "game:luckywheel:test": "cross-env MODE=luckywheel TEST_MODE=true node src/games/luckywheel/test.js",
    "game:quiz": "cross-env TEST_MODE=false MODE=quiz node server.js",
    "game:quiz:test": "cross-env MODE=quiz TEST_MODE=true node src/games/quiz/test.js",
    "pm2:start": "pm2 start ecosystem.config.js --only topix99-luckywheel",
    "pm2:start:luckywheel": "pm2 start ecosystem.config.js --only topix99-luckywheel",
    "pm2:start:luckywheel:test": "pm2 start ecosystem.config.js --only topix99-luckywheel-test",
    "pm2:start:quiz": "pm2 start ecosystem.config.js --only topix99-quiz-real-live",
    "pm2:start:quiz:real-live": "pm2 start ecosystem.config.js --only topix99-quiz-real-live",
    "pm2:start:quiz:test-live": "pm2 start ecosystem.config.js --only topix99-quiz-test-live",
    "pm2:start:quiz:test": "pm2 start ecosystem.config.js --only topix99-quiz-test",
    "pm2:stop": "pm2 stop topix99-luckywheel",
    "pm2:stop:luckywheel": "pm2 stop topix99-luckywheel",
    "pm2:stop:luckywheel:test": "pm2 stop topix99-luckywheel-test",
    "pm2:stop:quiz": "pm2 stop topix99-quiz-real-live",
    "pm2:stop:quiz:real-live": "pm2 stop topix99-quiz-real-live",
    "pm2:stop:quiz:test-live": "pm2 stop topix99-quiz-test-live",
    "pm2:stop:quiz:test": "pm2 stop topix99-quiz-test",
    "pm2:restart": "pm2 restart topix99-luckywheel",
    "pm2:restart:luckywheel": "pm2 restart topix99-luckywheel",
    "pm2:restart:luckywheel:test": "pm2 restart topix99-luckywheel-test",
    "pm2:restart:quiz": "pm2 restart topix99-quiz-real-live",
    "pm2:restart:quiz:real-live": "pm2 restart topix99-quiz-real-live",
    "pm2:restart:quiz:test-live": "pm2 restart topix99-quiz-test-live",
    "pm2:restart:quiz:test": "pm2 restart topix99-quiz-test",
    "pm2:delete": "pm2 delete topix99-luckywheel",
    "pm2:delete:luckywheel": "pm2 delete topix99-luckywheel",
    "pm2:delete:luckywheel:test": "pm2 delete topix99-luckywheel-test",
    "pm2:delete:quiz": "pm2 delete topix99-quiz-real-live topix99-quiz-test-live",
    "pm2:delete:quiz:real-live": "pm2 delete topix99-quiz-real-live",
    "pm2:delete:quiz:test-live": "pm2 delete topix99-quiz-test-live",
    "pm2:delete:quiz:test": "pm2 delete topix99-quiz-test",
    "pm2:logs": "pm2 logs topix99-luckywheel",
    "pm2:logs:luckywheel": "pm2 logs topix99-luckywheel",
    "pm2:logs:luckywheel:test": "pm2 logs topix99-luckywheel-test",
    "pm2:logs:quiz": "pm2 logs topix99-quiz-real-live",
    "pm2:logs:quiz:real-live": "pm2 logs topix99-quiz-real-live",
    "pm2:logs:quiz:test-live": "pm2 logs topix99-quiz-test-live",
    "pm2:logs:quiz:test": "pm2 logs topix99-quiz-test",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup",
    "util:check-status": "node scripts/check-status.js",
    "util:diagnose": "node scripts/diagnose.js",
    "util:show-errors": "node scripts/show-errors.js"
  },
  "dependencies": {
    "canvas": "^3.2.1",
    "chalk": "^5.6.2",
    "express": "^4.19.2",
    "node-fetch": "^3.3.2",
    "playwright-core": "^1.42.1",
    "redis": "^4.6.7",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
